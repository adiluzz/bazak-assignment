# Put your OpenAI key on the next line. The rest is ready for `docker compose up`.
OPENAI_API_KEY=
FAKE_LLM=0
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shop
CHECKPOINT_URL=postgresql://postgres:postgres@localhost:5432/shop
REDIS_URL=redis://localhost:6379/0
CATALOG_SOURCE_URL=https://dummyjson.com
SYNC_MODE=celery
SYNC_INTERVAL_MINUTES=60
EMBED_MODE=fastembed
AUTO_SYNC=1
SPA_DIST=web/dist
